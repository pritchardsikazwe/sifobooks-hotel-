{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SifoBooks Hotel",
  "version": "1.0.0",
  "identifier": "com.sifobooks.hotel",
  "build": { "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "SifoBooks Hotel", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 650 }], "security": { "csp": "default-src 'self' https: data: blob:; connect-src 'self' https: wss:;" } },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico"], "shortDescription": "SifoBooks Hotel Management", "category": "Business" }
}
