    "@capacitor/android": "^7.4.3"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "@capacitor/cli": "^7.4.3",
    "@tauri-apps/cli": "^2.8.4"
  }
